@startuml
' Styling
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

entity "User" {
    *id : UUID <<PK>>
    --
    name : string
    email : string
    location : string
    reputation_score : integer
    created_at : timestamp
}

entity "Item" {
    *id : UUID <<PK>>
    --
    *user_id : UUID <<FK>>
    *category_id : UUID <<FK>>
    name : string
    brand : string
    model : string
    purchase_date : date
    manual_url : string
    notes : text
    created_at : timestamp
}

entity "MaintenanceTask" {
    *id : UUID <<PK>>
    --
    *item_id : UUID <<FK>>
    description : text
    frequency : string
    difficulty_level : integer
    estimated_duration : interval
    required_tools : text[]
    instructions : text
    created_at : timestamp
}

entity "MaintenanceRecord" {
    *id : UUID <<PK>>
    --
    *task_id : UUID <<FK>>
    *user_id : UUID <<FK>>
    date_performed : timestamp
    status : enum
    notes : text
    feedback : text
    problems_encountered : text
    created_at : timestamp
}



' Relationships
User ||--o{ Item : owns
User ||--o{ MaintenanceRecord : performs

Item ||--o{ MaintenanceTask : requires


MaintenanceTask ||--o{ MaintenanceRecord : tracks

@enduml